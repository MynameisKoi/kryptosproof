# LLM — pydantic-ai model id (provider:model). In .env use any of: MODEL, AI_MODEL, ai_model
AI_MODEL=anthropic:claude-opus-4-6
# AI_MODEL=google-gla:gemini-2.5-flash

ANTHROPIC_API_KEY=
# For Gemini via Google AI Studio (pydantic-ai also reads GEMINI_API_KEY)
GOOGLE_AI_API=

TARGET_URL=http://localhost:8080
SANDBOX_TIMEOUT=30
RED_TEAM_NUCLEI_TIMEOUT=120
RED_TEAM_FFUF_TIMEOUT=90
RED_TEAM_SQLMAP_TIMEOUT=180
# Optional: clone https://github.com/swisskyrepo/PayloadsAllTheThings into third_party/PayloadsAllTheThings
PAYLOADS_ROOT=third_party/PayloadsAllTheThings
# Optional: local app clone for Gitleaks (blue team)
SOURCE_REPO_PATH=
GITLEAKS_TIMEOUT=120
# Optional: OWASP ZAP daemon JSON API
ZAP_PROXY_URL=http://127.0.0.1:8080
ZAP_API_KEY=
ZAP_SPIDER_MAX_WAIT=180
LOG_LEVEL=INFO
