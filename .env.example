ANTHROPIC_API_KEY=your_key_here
TARGET_URL=http://localhost:8080
MODEL=claude-opus-4-6
SANDBOX_TIMEOUT=30
RED_TEAM_NUCLEI_TIMEOUT=120
RED_TEAM_FFUF_TIMEOUT=90
RED_TEAM_SQLMAP_TIMEOUT=180
# Optional: clone https://github.com/swisskyrepo/PayloadsAllTheThings into third_party/PayloadsAllTheThings
